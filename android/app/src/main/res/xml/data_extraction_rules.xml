<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: what may leave the phone in a cloud backup or a device-to-device transfer.
  android:allowBackup="false" turns cloud backup off, but on Android 12+ device-to-device transfer
  ignores it, so the login (DataStore "clearplay": server address, user, token and salt) is
  excluded here explicitly. Cloud backup stays off for everything, as before.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/clearplay.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
